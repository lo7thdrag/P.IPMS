procedure TVoipSock.SetToMode_ExitPhone(const aPhoneId: integer);
var
  RecSend : TICSDataPhone;
begin
  //Off Before Exit
  SetToMode_Off(aPhoneId);

  with RecSend do
  begin
    cmd   := 'quit';
    Mode  := 1;
    id    := aPhoneId;
  end;

  TCP_ClientConnector.SendData(CPID_ICSDataPhone, @RecSend);
  Sleep(10);

  aLoggerFile.Log('Mode', 'Set Mode to Exit')
end;

