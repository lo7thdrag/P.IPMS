procedure TfrmIpmsHandledPhone.pnlControlClick(Sender: TObject);
begin
  if not tmrIncomingBlinker.Enabled then begin
    FBlinkerCounter := 0;
    tmrIncomingBlinker.Tag := 0;
    tmrIncomingBlinker.Enabled := True;
  end
  else begin
    FBlinkerCounter := 0;
    tmrIncomingBlinker.Tag := 0;
    tmrIncomingBlinker.Enabled := False;
    lblIncoming.Font.Color := clWhite;
  end;
end;

procedure TfrmIpmsHandledPhone.tmrIncomingBlinkerTimer(Sender: TObject);
begin
  if (tmrIncomingBlinker.Tag = 0) then begin
    //LoadFromImageListUp(22, imgCal, FBitMap);
    lblIncoming.Font.Color := clWhite;
    tmrIncomingBlinker.Tag := 1;
  end
  else if (tmrIncomingBlinker.Tag = 1) then begin
    //LoadFromImageListDown(22, imgCal, FBitMap);
    lblIncoming.Font.Color := clRed;
    tmrIncomingBlinker.Tag := 0;
  end;
  Inc(FBlinkerCounter);

  // if autocall, turnoff blinker after 20 sec. if not already turned off
  if (FBlinkerCounter > 40) then begin // 40 since interval is half a sec
    lblIncoming.Font.Color := clWhite;
    tmrIncomingBlinker.Tag := 0;
    FBlinkerCounter := 0;
    tmrIncomingBlinker.Enabled := False;
  end;
end;

