procedure TfrmLenBigVertApvc768.ButtonDown(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
var
  aTag : Integer;
  aTImage : TImage;
begin
  aTag    := TImage(sender).Tag;
  aTImage := TImage(sender);

  //There Some Button Not Use Mouse Down
  if(aTag = 16) or (aTag = 18) then Exit;

  LoadFromImageListDown(aTag, aTImage, FBitMap);

  case aTag of

    22:
    begin
      LoadFromImageListDown(22, imgCal, FBitMap);
    end;

  end;
end;

procedure TfrmLenBigVertApvc768.ButtonUp(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
var
  aTag : Integer;
  aTImage : TImage;
begin
  aTag    := TImage(sender).Tag;
  aTImage := TImage(sender);

  // blinker
  if (aTag = 22) then begin
    tmrIncomingBlinker.Tag := 0;
    FBlinkerCounter := 0;
    tmrIncomingBlinker.Enabled := False;
  end;

  //There Some Button Not Use Mouse Up
  if (aTag = 31) or (aTag = 32) or (aTag = 33)
      or (aTag = 16) or (aTag = 18) then Exit;

  LoadFromImageListUp(aTag, aTImage, FBitMap);

end;

procedure TfrmLenBigVertApvc768.ClearAndDelList(aList: TList);
