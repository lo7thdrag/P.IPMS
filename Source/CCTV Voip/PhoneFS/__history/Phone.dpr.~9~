  Logger in '..\LibUnit\Logger.pas',
  uLoadSetting in '..\LibUnit\uLoadSetting.pas',
  uScriptHandle in '..\LibUnit\uScriptHandle.pas',
  uSocketHandle in '..\LibUnit\uSocketHandle.pas',
  uDataVoipRecord in '..\DataRecordType\uDataVoipRecord.pas',
  uEventConnector in '..\LibUnit\uEventConnector.pas',
  uProgressBar in '..\LibForm\uProgressBar.pas' {frmProgress},
  uLoadGroupFromXML in '..\LibUnit\uLoadGroupFromXML.pas',
  GmXml in '..\XMLReader\GmXml.pas',
  GmXMLInterface in '..\XMLReader\GmXMLInterface.pas',
  uStringFunc in '..\XMLReader\uStringFunc.pas',
  xmlInterface in '..\XMLReader\xmlInterface.pas',
  uMainIPMS in 'uMainIPMS.pas' {frmMainIPMS},
