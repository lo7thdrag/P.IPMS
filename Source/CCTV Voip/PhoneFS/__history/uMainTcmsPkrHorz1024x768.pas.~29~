  begin
    aChannelMap := TChannelMap.Create;
    aChannelMap.aUser         := IntToStr(1001 + i);
    aChannelMap.aChannel      := IntToStr(VoipManager.SetConfig.aRoomExternal + i);

    aChannelMap.aChannelName  := ssGroupList.ExternalList[i];
