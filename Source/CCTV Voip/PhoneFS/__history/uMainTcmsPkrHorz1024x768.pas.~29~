  for i := 0 to ssGroupList.RoleList.Count - 1 do
  begin
    aChannelMap := TChannelMap.Create;
    aChannelMap.aUser         := IntToStr(1001 + i);
    aChannelMap.aChannel      := IntToStr(VoipManager.SetConfig.aRoomInternal +
